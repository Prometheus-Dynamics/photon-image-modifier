config BR2_PACKAGE_PHOTONVISION_JRE
	bool "photonvision-jre"
	depends on BR2_aarch64
	depends on BR2_TOOLCHAIN_USES_GLIBC
	help
	  A minimal Java 25 runtime for PhotonVision, linked with jlink
	  from Eclipse Temurin's prebuilt aarch64 jmods (no OpenJDK
	  build), installed to /usr/lib/jvm with /usr/bin/java.

	  https://adoptium.net/

comment "photonvision-jre needs an aarch64 glibc toolchain"
	depends on !BR2_aarch64 || !BR2_TOOLCHAIN_USES_GLIBC
