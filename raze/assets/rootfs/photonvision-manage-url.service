[Unit]
Description=Publish PhotonVision's web UI address for Atlas (manage_url)
# An early unit: it only needs /run and the hostname, and board-identity (in
# sysinit.target) reads its file. Without DefaultDependencies=no it is ordered
# after basic.target, which made an ordering cycle with sysinit.target.
DefaultDependencies=no
After=local-fs.target board-hostname.service
Before=board-identity.service shutdown.target
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/photonvision-os/manage-url

[Install]
WantedBy=sysinit.target
