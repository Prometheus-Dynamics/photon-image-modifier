#!/bin/sh
# PhotonVision -> Raze LED ring. PhotonVision's hardware config
# (/opt/photonvision/photonvision_config/hardwareConfig.json) drives its
# "vision LED" through custom GPIO commands; this maps their argument forms
# onto the device package's raze-leds helper, which owns /dev/leds0.
#
#   pv-leds gpio <pin> <true|false>    setGPIOCommand  ({p} {s})
#   pv-leds pwm  <pin> <0.0..1.0>      setPWMCommand   ({p} {v})
#   pv-leds get  <pin>                 getGPIOCommand  ({p}) -> true|false
#   pv-leds freq <pin> <hz>            setPWMFrequencyCommand (ignored)
#   pv-leds release <pin>              releaseGPIOCommand (ignored)
#
# The ring is pin 13 (its GPIO); other pins only keep state for `get`.
set -u

LEDS=/usr/lib/pd-device/raze-leds
RING_PIN=13
STATE=/run/photonvision-os/leds

cmd=${1:-}
pin=${2:-}
val=${3:-}
mkdir -p "$STATE"

remember() { printf '%s\n' "$1" >"$STATE/pin-$pin"; }

case "$cmd" in
gpio)
	case "$val" in true | 1) on=1 ;; *) on=0 ;; esac
	remember "$on"
	[ "$pin" = "$RING_PIN" ] && exec "$LEDS" set "$on"
	;;
pwm)
	pct=$(awk -v v="$val" 'BEGIN { p = int(v * 100 + 0.5); if (p < 0) p = 0; if (p > 100) p = 100; print p }')
	if [ "$pct" -eq 0 ]; then
		remember 0
		[ "$pin" = "$RING_PIN" ] && exec "$LEDS" set 0
	else
		remember 1
		if [ "$pin" = "$RING_PIN" ]; then
			"$LEDS" dim "$pct" && exec "$LEDS" set 1
		fi
	fi
	;;
get)
	[ "$(cat "$STATE/pin-$pin" 2>/dev/null)" = 1 ] && echo true || echo false
	;;
freq | release) ;;
*)
	echo "usage: pv-leds gpio|pwm|get|freq|release <pin> [value]" >&2
	exit 2
	;;
esac
