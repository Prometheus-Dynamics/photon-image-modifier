#!/bin/sh
# Prepare /data, the partition kept across A/B updates (p7), before
# PhotonVision and sshd start. data-early has already made sure /data is
# mounted (the partition, or a tmpfs if it is missing).
#
#   - PhotonVision's settings directory lives in /data/photonvision_config
#     and is bind-mounted over /opt/photonvision/photonvision_config (the root
#     filesystem is read-only). The first boot seeds it from the image; the
#     image's hardwareConfig.json is copied in on every boot, so an update
#     brings the current hardware defaults (PhotonVision only reads it when
#     its database has none). PhotonVision's logs are in its logs/ there.
#   - SSH host keys live in /data/ssh, where sshd reads them
#     (/etc/ssh/sshd_config.d/40-photonvision-os.conf), so a board keeps its
#     host key across updates. Boards updated from an ext4 image already have
#     them there.
set -eu

log() { echo "data-setup: $*"; }

data=/data
image_config=/opt/photonvision/photonvision_config
defaults=/usr/share/photonvision-os/photonvision_config

if ! mountpoint -q "$data"; then
	log "error: $data is not mounted"
	exit 1
fi

# PhotonVision settings.
mkdir -p "$data/photonvision_config"
if [ ! -e "$data/photonvision_config/.seeded" ]; then
	log "seeding $data/photonvision_config from the image"
	cp -a "$defaults/." "$data/photonvision_config/"
	: >"$data/photonvision_config/.seeded"
fi
cp "$defaults/hardwareConfig.json" "$data/photonvision_config/hardwareConfig.json"
mountpoint -q "$image_config" || mount --bind "$data/photonvision_config" "$image_config"

# SSH host keys: generate the missing ones once, on /data.
mkdir -p "$data/ssh"
chmod 700 "$data/ssh"
for type in ed25519 ecdsa rsa; do
	key="$data/ssh/ssh_host_${type}_key"
	if [ ! -s "$key" ]; then
		log "generating the $type SSH host key"
		rm -f "$key" "$key.pub"
		ssh-keygen -q -t "$type" -N '' -C "root@$(hostname)" -f "$key"
	fi
	chmod 600 "$key"
done
