#!/bin/sh
# Health check for the device package's A/B updater (board-update-confirm):
# exit 0 keeps the trial boot, anything else rolls back to the previous slot.
# PhotonVision is healthy when its service is active and its web server
# answers on port 5800; it can take a while to unpack natives on first start.
i=0
while [ "$i" -lt 60 ]; do
	if systemctl is-active --quiet photonvision.service &&
		wget -q -T 3 -O /dev/null http://127.0.0.1:5800/ 2>/dev/null; then
		exit 0
	fi
	i=$((i + 1))
	sleep 2
done
echo "update-health: photonvision.service or :5800 not healthy after 120 s" >&2
# The journal is in RAM and the rollback restarts the board: keep what this
# trial boot's PhotonVision said on /data, for whoever looks into it.
log=/data/board/update-health.log
{
	echo "=== $(date -u +%FT%TZ) $(cat /etc/os-release 2>/dev/null | sed -n 's/^VERSION=//p')"
	systemctl status --no-pager photonvision.service 2>&1 | head -n 20
	journalctl -b -u photonvision.service --no-pager -o short-monotonic 2>&1 | tail -n 300
} >>"$log" 2>/dev/null
tail -c 1048576 "$log" >"$log.tmp" 2>/dev/null && mv "$log.tmp" "$log"
exit 1
