CONFIG_MEDIA_CONTROLLER=y
CONFIG_MEDIA_SUPPORT=y
CONFIG_MEDIA_PLATFORM_SUPPORT=y
CONFIG_MEDIA_CAMERA_SUPPORT=y
CONFIG_MEDIA_CONTROLLER_REQUEST_API=y
CONFIG_V4L2_SUBDEV_API=y
CONFIG_V4L2_FWNODE=y
CONFIG_V4L2_ASYNC=y
CONFIG_I2C_CHARDEV=y
CONFIG_VIDEO_BCM2835_UNICAM=y
CONFIG_VIDEO_BCM2835_ISP=y
# Enable the Raspberry Pi VideoCore (MMAL/VCHIQ) codec mem2mem device (bcm2835-codec).
# This exposes V4L2 M2M encode/decode/format-conversion nodes that FFmpeg and Styx can use.
CONFIG_VIDEO_CODEC_BCM2835=y
# Expose the VCHIQ interface and MMAL bindings so vcgencmd/telemetry and
# VideoCore-driven codecs can function.
CONFIG_BCM2835_VCHIQ=m
CONFIG_BCM2835_VCHIQ_MMAL=m
