CONFIG_USB_GADGET=y
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_RNDIS=y
# Prefer configfs functions over monolithic g_ether driver
# CONFIG_USB_ETH is not set
# CONFIG_USB_ETH_RNDIS is not set
CONFIG_USB_U_ETHER=y

# Ensure the configfs filesystem is available for gadget setup
CONFIG_CONFIGFS_FS=y

# DWC2 USB controller in dual-role (host/device) mode
CONFIG_USB_DWC2=y
# Force peripheral-only mode so a UDC is always created, even if DT dr_mode
# is missing or role-switch nodes are unavailable on the platform.
CONFIG_USB_DWC2_PERIPHERAL=y
# CONFIG_USB_DWC2_DUAL_ROLE is not set
# CONFIG_USB_DWC2_HOST is not set
# USB_ROLE_SWITCH is not required in peripheral-only mode
# CONFIG_USB_ROLE_SWITCH is not set
# Disable the legacy Raspberry Pi DWC OTG driver so DWC2 can bind
# CONFIG_USB_DWCOTG is not set

# Expose the running kernel config at /proc/config.gz for diagnostics
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
