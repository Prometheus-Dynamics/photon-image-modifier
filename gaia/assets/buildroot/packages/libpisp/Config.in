config BR2_PACKAGE_LIBPISP
	bool "libpisp"
	depends on BR2_INSTALL_LIBSTDCPP
	depends on BR2_TOOLCHAIN_HAS_THREADS
	depends on BR2_TOOLCHAIN_GCC_AT_LEAST_9
	select BR2_PACKAGE_BOOST
	select BR2_PACKAGE_JSON_FOR_MODERN_CPP
	help
	  Raspberry Pi PiSP helper library (backend/frontend configuration and
	  tiling utilities) used by the libcamera rpi/pisp pipeline.

comment "libpisp needs a toolchain w/ C++, threads, gcc >= 9"
	depends on !BR2_INSTALL_LIBSTDCPP || !BR2_TOOLCHAIN_HAS_THREADS || \
		!BR2_TOOLCHAIN_GCC_AT_LEAST_9
