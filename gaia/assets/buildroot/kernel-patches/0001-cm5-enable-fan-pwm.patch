From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Codex <codex@example.com>
Date: Tue, 25 Feb 2025 00:00:00 +0000
Subject: [PATCH] arm64: dts: rpi: enable CM5 dedicated fan PWM/tacho

Enable the CM5 board's dedicated fan controller and PWM instance so the
kernel exposes `/sys/class/hwmon/.../pwm1` and rpm feedback on the
FAN_PWM/FAN_TACH lines. This turns on the existing pwm-fan node and the
corresponding RP1 PWM block; the defaults remain the upstream cooling
levels and inverted polarity.

---
 arch/arm64/boot/dts/broadcom/bcm2712-rpi-cm5.dtsi | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/arch/arm64/boot/dts/broadcom/bcm2712-rpi-cm5.dtsi b/arch/arm64/boot/dts/broadcom/bcm2712-rpi-cm5.dtsi
index 60d7f0b98c84..cdd9c3cdb871 100644
--- a/arch/arm64/boot/dts/broadcom/bcm2712-rpi-cm5.dtsi
+++ b/arch/arm64/boot/dts/broadcom/bcm2712-rpi-cm5.dtsi
@@
-	fan: cooling_fan {
-		status = "disabled";
+	fan: cooling_fan {
+		status = "okay";
 		compatible = "pwm-fan";
 		#cooling-cells = <2>;
 		cooling-min-state = <0>;
@@
-&rp1_pwm1 {
-	status = "disabled";
+&rp1_pwm1 {
+	status = "okay";
 	pinctrl-0 = <&rp1_pwm1_gpio45>;
 	pinctrl-names = "default";
 };
-- 
